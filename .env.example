# Copy to .env (gitignored) and fill in.
#
#   cp .env.example .env
#
# --- Transcription (Deepgram) ---
# Nova-3 with filler_words=true for verbatim output and per-word timings.
# Key: https://console.deepgram.com
DEEPGRAM_API_KEY=

# Optional. Defaults to nova-3.
# DEEPGRAM_MODEL=nova-3

# Optional. Swap the ASR provider (only "deepgram" implemented so far).
# ASR_PROVIDER=deepgram

# --- Analysis (Gemini) ---
# Receives the transcript as TEXT only. Never receives audio.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash. Text-in, JSON-out only.
# GEMINI_MODEL=gemini-3.6-flash

# Optional. Port the API server binds to. Defaults to 8080.
# PORT=8080

# --- Mobile app ---
# Not read from this file (Expo reads EXPO_PUBLIC_* from the shell or
# mobile/.env). Recorded here so the whole config surface is in
# one place.
#
# Full origin including scheme. On a physical device, localhost is the PHONE,
# so use your Mac's LAN IP: ipconfig getifaddr en0
#   EXPO_PUBLIC_API_URL=http://192.168.2.226:8080
